# =============================================================
#  ft_transcendence - environment example
#
#  1. cp .env.example .env
#  2. Create the secret files (list at the end of this file)
#  3. make
#
#  This file holds NO secrets. Never commit .env or secrets/.
# =============================================================

# ---------- General ----------
APP_ENV=production

# ---------- Database (PostgreSQL) ----------
DB_USER=admin
DB_NAME=rackets_db

# one database role per service, each owns only its own schema
AUTH_USER=auth_service
CLUB_USER=club_service
NOTIFICATION_USER=notification_service

AUTH_SCHEMA=auth_schema
CLUB_SCHEMA=club_schema
NOTIFICATION_SCHEMA=notification_schema

# ---------- Auth ----------
JWT_ACCESS_EXPIRES_IN=15m

# ---------- RabbitMQ ----------
RABBITMQ_USER=rabbit

# ---------- URLs ----------
FRONTEND_URL=https://localhost
GOOGLE_REDIRECT_URI=https://localhost/api/v1/auth/google/callback

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_FROM_EMAIL=support@example.com

# ---------- Frontend (read at build time) ----------
NEXT_PUBLIC_API_PREFIX=/api/v1

# =============================================================
#  SECRETS: they are NOT in this file
#
#  Create one file per secret in ./secrets/ (the folder is ignored by Git).
#  Write only the value, with no trailing newline:
#
#     printf '%s' 'the-value' > secrets/db_password.txt
#
#  File                               Content
#  ---------------------------------  ------------------------------------
#  db_password.txt                    password of the database admin role
#  auth_service_password.txt          password of the auth_service role
#  club_service_password.txt          password of the club_service role
#  notification_service_password.txt  password of the notification_service role
#  rabbitmq_password.txt              RabbitMQ password
#  jwt_access_secret.txt              long random string, e.g. openssl rand -hex 32
#  smtp_password.txt                  SMTP API key (Resend)
#  google_client_id.txt               Google OAuth client id
#  google_client_secret.txt           Google OAuth client secret
# =============================================================
