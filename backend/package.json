{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:club": "nest start club-service --watch",
    "start:dev:notification": "nest start notification-service --watch",
    "start:dev:all": "concurrently -n gateway,auth,club,notif -c blue,green,yellow,magenta \"npm:start:dev:gateway\" \"npm:start:dev:auth\" \"npm:start:dev:club\" \"npm:start:dev:notification\"",
    "prisma:auth-service": "prisma --config apps/auth-service/prisma7.config.ts",
    "prisma:studio:auth": "prisma studio --config apps/auth-service/prisma7.config.ts",
    "prisma:club-service": "prisma --config apps/club-service/prisma7.config.ts",
    "prisma:notification-service": "prisma --config apps/notification-service/prisma7.config.ts",
    "prisma:studio:club": "prisma studio --config apps/club-service/prisma7.config.ts",
    "prisma:studio:notification": "prisma studio --config apps/notification-service/prisma7.config.ts",
    "db:migrate:dev:auth": "npm run prisma:auth-service -- migrate dev",
    "db:migrate:dev:club": "npm run prisma:club-service -- migrate dev",
    "db:migrate:dev:notification": "npm run prisma:notification-service -- migrate dev",
    "db:generate": "npm run prisma:auth-service -- generate && npm run prisma:club-service -- generate && npm run prisma:notification-service -- generate",
    "db:migrate": "npm run prisma:auth-service -- migrate deploy && npm run prisma:club-service -- migrate deploy && npm run prisma:notification-service -- migrate deploy",
    "db:status": "npm run prisma:auth-service -- migrate status && npm run prisma:club-service -- migrate status && npm run prisma:notification-service -- migrate status",
    "db:seed": "npm run prisma:auth-service -- db seed && npm run prisma:club-service -- db seed && npm run prisma:notification-service -- db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "nodemailer": "^10.1.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.8",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
