# Frontend variables. Next.js reads them at BUILD time and bakes them into the app.
#
# With Docker (make), docker-compose.yml sets them from the root .env:
#   NEXT_PUBLIC_API_URL    <- FRONTEND_URL
#   NEXT_PUBLIC_API_PREFIX <- NEXT_PUBLIC_API_PREFIX
#
# This file is only for running the frontend alone, outside Docker.
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_API_PREFIX=/api/v1
